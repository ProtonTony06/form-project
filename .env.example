# =============================================================================
# FormProject — Variables de entorno (ejemplo)
# =============================================================================
# Copia este archivo a `.env.local` y rellena con tus valores reales.
# NUNCA commitees `.env.local` al repositorio.

# ─── Supabase ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."   # server-only
DATABASE_URL="postgresql://postgres.xxxxxxxxx:[PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar-con: openssl rand -base64 32"

# ─── Admin (credenciales del único usuario administrador) ──────────────────────
ADMIN_EMAIL="tu-email@ejemplo.com"
ADMIN_PASSWORD_HASH="$2a$12$..."  # bcrypt hash; se genera con scripts/seed.ts

# ─── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="FormProject <noreply@tudominio.com>"

# ─── Notificaciones ────────────────────────────────────────────────────────────
USER_NOTIFICATION_EMAIL="tu-email-personal@gmail.com"

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_SECONDS="600"