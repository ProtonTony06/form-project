# =============================================================================
# FormProject — Variables de entorno (ejemplo)
# =============================================================================
# Copia este archivo a `.env.local` y rellena con tus valores reales.
# NUNCA commitees `.env.local` al repositorio.

# ─── Supabase ──────────────────────────────────────────────────────────────────
# Cliente + Project ID (TODAS públicas; se exponen al navegador sin riesgo).
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# service_role: bypasea RLS. SOLO usar en servidor (scripts, Server Actions,
# Route Handlers). NUNCA importar en Client Components.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
# Conexión directa a Postgres (usada por `scripts/migrate.ts` y para `psql`).
# Nota: este host solo resuelve en IPv6; desde Windows/IPv4 usa el pooler.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[project-ref].supabase.co:5432/postgres"
# ID del proyecto (lo necesitas para `npm run db:types`).
SUPABASE_PROJECT_ID="xxxxxxxxxxxxx"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generar-con: openssl rand -base64 32"

# ─── Admin (Fase 1 — credenciales reales en BD) ───────────────────────────────
# El email/password se guardan en la tabla `admin_user` (hasheado con bcrypt).
# Para crear el primer admin: `npm run seed` (interactivo, pide email/password).
ADMIN_EMAIL="tu-email@ejemplo.com"
ADMIN_PASSWORD_HASH=""  # legacy; ya no se usa (la tabla admin_user es la fuente)

# ─── Admin (Fase 2 — fallback hardcoded en texto plano, solo dev) ──────────────
# Si estas variables están definidas, tienen prioridad sobre Supabase en el
# `authorize` de NextAuth. Útil para arrancar sin necesidad de sembrar la BD.
# En producción se recomienda dejarlas vacías.
HARDCODE_ADMIN_EMAIL="admin@formproject.local"
HARDCODE_ADMIN_PASSWORD="formproject2026"

# ─── Rate Limiting (endpoint público /api/submit/[slug]) ─────────────────────
# `RATE_LIMIT_MAX` submits por IP durante `RATE_LIMIT_WINDOW_SECONDS` segundos.
# Tras el pivot del MVP (email → persistencia en BD) sigue siendo útil para
# evitar spam. In-memory (se resetea con cada deploy).
RATE_LIMIT_MAX="5"
RATE_LIMIT_WINDOW_SECONDS="600"